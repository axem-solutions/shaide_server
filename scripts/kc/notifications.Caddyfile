{
    admin off
    auto_https off
}
:8080 {
    @event {
        path /v1/object-storage/event
        method POST
    }
    handle @event {
        # Fixed destination; incoming bearer token is authenticated by shaide.
        reverse_proxy shaide_server:{$SHAIDE_SERVER_PORT:8080} {
            transport http {
                dial_timeout 5s
                response_header_timeout 120s
            }
        }
    }
    handle /health {
        respond "ok" 200
    }
    handle {
        respond 404
    }
}
