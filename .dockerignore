# Rust build artifacts: 6+ GB locally and never needed inside the image.
target/

# Version control and CI configuration.
.git/
.gitignore
.github/

# Editor and agent tooling.
.vscode/
.claude/

# The image's Rust version is pinned by the Dockerfile's base image tag. Inside
# the image, rust-toolchain.toml would only make rustup download the rustfmt
# and clippy components the release build does not use.
rust-toolchain.toml

# Docker's own files.
Dockerfile
.dockerignore
compose.yaml

# NOTE: do not ignore .sqlx/ - the image build sets SQLX_OFFLINE=true and
# needs the cached query metadata to compile.
